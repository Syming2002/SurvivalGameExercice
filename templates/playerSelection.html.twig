{% extends "base.html.twig" %}

{% block choosePlayer %}
<style>
    main {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 25px;
    }
    .choose-player-name {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 25px;
    }
    .player-username-label {
        margin-top: 25px;
    }
    .button {
        background-color: grey;
        color: white;
        font-family: monocraft;
        src: url("../fonts/Monocraft.ttf");
        width: calc(200px - 32px);
        height: calc(75px - 24px);
    }
    .start-button {
        margin-top: 25px;
    }
</style>
    <form class="choose-player-name" action="/../../Exercices PHP/Survival Game/inGame.php" method="GET">
            <label class="player-username-label" for="player_id">Choose a player</label>
                {% if players is not empty %}
                    <select name="player_id" id="player_id">
                        {% for player in players %}
                            <option value="{{ player.player_id }}">
                                {{player.player_username}}
                            </option>
                            {% else %}
                                <p>No player found !</p>
                        {% endfor %}
                    </select>
                {% endif %}
            <button class="button start-button" type="submit">Start the game</button>
        </form>
{% endblock %}