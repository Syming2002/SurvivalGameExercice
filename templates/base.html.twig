<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <style>
    *,
    ::before,
    ::after {
      box-sizing: border-box;
      padding: 0;
      margin: 0;
    }
    body {
      font-family: monocraft;
      src: url("../fonts/Monocraft.ttf");
      height: 100vh;
    }
    .main {
      display: flex;
      justify-content: center;
      flex-direction: column;
      align-items: center;
    }
    .header {
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: darkgray;
      height: calc(100px - 25px);
      border-bottom-left-radius: 32px;
      border-bottom-right-radius: 32px;
    }
    .main-title {
      font-family: monocraft;
      src: url("../fonts/Monocraft.ttf");
    }
  </style>
  <body>
    {% block header %}
    {% endblock %}
    <main>
      {% block createPlayer %}
      {% endblock %}
      {% block connexion %}
      {% endblock %}
      {% block inGame %}
      {% endblock %}
    </main>
  </body>
</html>
